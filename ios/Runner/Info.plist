<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>$(APP_DISPLAY_NAME)</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>WeHum</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>wehum</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
				</array>
			</dict>
		</array>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>FirebaseAppDelegateProxyEnabled</key>
		<true/>
		<key>GIDClientID</key>
		<string>$(GOOGLE_CLIENT_ID)</string>
		<key>GIDServerClientID</key>
		<string>717113097844-7grv4tr0q2q89068qcjdp2dj8s1m1a3s.apps.googleusercontent.com</string>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>mailto</string>
			<string>message</string>
			<string>https</string>
			<string>instagram-stories</string>
		</array>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>WeHum uses your approximate location once, only to find your country and light it up on the world map of people meditating now. Your exact position is never saved or shared.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>WeHum uses your approximate location once, only to find your country for the world map of people meditating now. It is never used in the background and your exact position is never saved or shared.</string>
		<key>NSHealthShareUsageDescription</key>
		<string>WeHum reads your heart rate from Apple Health only for the time of a meditation, to show how your body settled. Only the average and the change are saved to your account.</string>
		<key>NSHealthUpdateUsageDescription</key>
		<string>WeHum only reads heart rate and heart rate variability to show changes during meditation. It does not save or change data in Apple Health.</string>
		<key>NSBluetoothAlwaysUsageDescription</key>
		<string>WeHum connects to your heart-rate sensor (a chest strap, or a watch or band that broadcasts heart rate) to show your heart rate during a meditation.</string>
		<key>NSCalendarsUsageDescription</key>
		<string>WeHum adds the group meditation to your calendar when you tap Add to calendar.</string>
		<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
		<string>WeHum adds the group meditation to your calendar when you tap Add to calendar.</string>
		<key>NSContactsUsageDescription</key>
		<string>The calendar screen can show your contacts if you choose to invite someone to the event. WeHum itself never reads your contacts.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Choose a profile photo. It is only used for your profile.</string>
		<key>NSCameraUsageDescription</key>
		<string>Take a profile photo. It is only used for your profile.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>WeHum saves the share image of your meditation to your photo library when you tap Save to Photos.</string>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIBackgroundModes</key>
